  "code_change_rules": {
    "contract": "mad4b.readiness-reviewed-changes.v1",
    "authorizing": false,
    "runtime_root": "wp-content/plugins/mad4b-site-control-plane/",
    "covered_extensions": [
      ".php",
      ".js",
      ".css",
      ".json"
    ],
    "included_subtrees": [
      "includes/",
      "assets/",
      "config/"
    ],
    "root_php": true,
    "excluded_subtrees": [
      "tests/",
      "docs/",
      "languages/"
    ],
