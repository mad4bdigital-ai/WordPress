    "value_exported": false
  },
  "scope_model": {
    "site_per_company": "Each company-specific WordPress site has isolated DB, site identity and global JetEngine option entries; no option values may cross company boundaries",
    "multi_company_single_site": "Native get_option(slug) is site-global and MUST NOT be treated as company-scoped; must use tenant/site_uuid authenticated resolver and company-specific storage with ACL and no fallback to another company's values",
    "language": "Neutral English source for demo templates; translations per target company/language and per-site WPML identifier mapping"
  },
  "default_unknown": "BLOCK_REVIEW",
  "policy_definitions": {
    "SCHEMA_ONLY": "JetEngine layout/tab/section definitions: code source only; never clone stored values",
    "TENANT_MEDIA": "Company-owned, permissioned and licensed image/gallery, rebind media IDs",
    "TENANT_BRAND": "Company-owned colors, patterns, visual identity",
    "TENANT_PRESENTATION": "Company-selected card/presentation mode; template-safe defaults only",
    "TENANT_MARKETING": "Company-owned editorial/CTA copy; Wo Vacation demo seed only when target explicitly demo",
    "TENANT_CONTACT": "Company-owned email, phone, WhatsApp, address, recipients, social profiles; blank if not verified",
    "TENANT_ROUTE": "Destination-local authorized path; revalidate URL on clone and disable external paths by default",
    "RECONNECT_PROVIDER": "Explicit reconnect to target-owned external service; no token/account ID inheritance",
    "TENANT_PERSONNEL": "Personally identifying staffing/partner membership; no cross-company copy",
    "TENANT_IDENTITY": "Authoritative company display name tied to enrolled site/company",
    "TENANT_OPERATIONS": "Operational controls; new company receives safe defaults, not legacy permission/effects",
    "TENANT_LOCALE": "Company and language-specific calendar/date preferences",
    "TENANT_CATALOG": "Tenant-specific channels, allowed destinations, exposure and recommendations",
    "TENANT_COMMERCE_GATED": "Rate formula, tax, fees, payment/visa/availability; new-company defaults OFF until certified and separately approved",
    "BLOCK_REVIEW": "No automatic clone without independent field classification"
  },
