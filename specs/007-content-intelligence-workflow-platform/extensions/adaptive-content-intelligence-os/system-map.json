      "id": "discovery",
      "trigger": "user_or_schedule",
      "output": "OpportunityHypothesis",
      "hard_stop": "non_comparable_signal_or_missing_consent"
    },
    {
      "id": "evidence",
      "trigger": "accepted_hypothesis",
      "output": "EvidencePack",
      "hard_stop": "rights_or_provider_uncertainty"
    },
    {
      "id": "content",
      "trigger": "reviewed_blueprint_intent",
      "output": "DraftArtifact",
      "hard_stop": "unsupported_claim_or_unknown_relationship"
    },
    {
      "id": "validation",
      "trigger": "candidate_publish_change",
      "output": "PublishEligibilityDecision",
      "hard_stop": "missing_exact_approval_or_cas_or_native_readback"
    },
    {
      "id": "optimization",
      "trigger": "comparable_growth_window",
      "output": "OptimizationProposal",
      "hard_stop": "confounded_outcome_or_unbounded_spend"
    }
  ],
