      "hard_stop": "unsupported_claim_or_unknown_relationship"
    },
    {
      "id": "validation",
      "trigger": "candidate_publish_change",
      "output": "PublishEligibilityDecision",
      "hard_stop": "missing_exact_approval_or_cas_or_native_readback"
    },
    {
      "id": "optimization",
      "trigger": "comparable_growth_window",
      "output": "OptimizationProposal",
      "hard_stop": "confounded_outcome_or_unbounded_spend"
    }
  ],
