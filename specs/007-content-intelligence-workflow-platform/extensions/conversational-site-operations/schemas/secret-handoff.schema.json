{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "state",
    "session_ref",
    "site_uuid",
    "field_ref",
    "expires_at",
    "plaintext_in_chat"
  ],
  "properties": {
    "contract": {
      "type": "string",
      "enum": [
        "mad4b.cso01.secret-handoff.v1"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "PREPARED",
        "OPENED",
        "STORED",
        "VERIFIED",
        "EXPIRED",
        "REVOKED",
        "DENIED"
      ]
    },
    "session_ref": {
      "type": "string",
      "minLength": 16
    },
    "site_uuid": {
      "type": "string",
      "minLength": 8
    },
    "field_ref": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "minLength": 10
    },
    "origin": {
      "type": "string",
      "pattern": "^https://"
    },
    "plaintext_in_chat": {
      "type": "boolean",
      "enum": [
        false
      ]
    },
    "configured": {
      "type": "boolean"
    },
    "signed_receipt_ref": {
      "type": "string"
    }
  },
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "CSO01 secret-handoff design schema; NOT an automatically registered WordPress Ability"
}
