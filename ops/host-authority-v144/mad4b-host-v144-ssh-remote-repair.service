[Unit]
Description=MAD4B Root-pinned VPS-to-Hosting SSH Remote Repair Readiness
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/mad4b-company-transport/host-authority-v144-ssh-repair-readonly/vps_host_ssh_repair.py

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/
ExecStart=/usr/bin/python3 -B /opt/mad4b-company-transport/host-authority-v144-ssh-repair-readonly/vps_host_ssh_repair.py publish
TimeoutStartSec=75
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/mad4b-company-transport/host-authority-v144-ssh-repair-readonly
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
