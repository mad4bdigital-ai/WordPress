[Unit]
Description=MAD4B Dispatch noncritical readback and diagnostics (triggered by original core)
After=network-online.target docker.service mad4b-dispatch-v1.service
# Priority: next core dispatch cancels an overlong diagnostic sweep.
Conflicts=mad4b-dispatch-v1.service
ConditionPathExists=/opt/mad4b-company-transport

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/opt/mad4b-company-transport
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/mad4b-company-transport
PrivateTmp=true
TimeoutStartSec=360
ExecStart=-/usr/bin/python3 /opt/mad4b-company-transport/status-sync-v1.py
ExecStart=-/usr/bin/python3 /opt/mad4b-company-transport/broker-v1/vps-broker-fixed-diagnostic.py
ExecStart=-/usr/bin/python3 /opt/mad4b-company-transport/broker-v1/remote-exact-canary.py run
ExecStart=-/usr/bin/python3 /opt/mad4b-company-transport/broker-v1/vps-broker-journal-sync.py sync
ExecStart=-/usr/bin/python3 /opt/mad4b-company-transport/broker-v1/vps-broker-registry-ssh-status-sync.py sync
ExecStart=-/usr/bin/python3 /opt/mad4b-company-transport/universal-runtime-v1/resolver.py scheduled
ExecStart=-/usr/bin/python3 /opt/mad4b-company-transport/unified-execution-router-v1/proof_renewal.py
ExecStart=-/usr/bin/python3 /opt/mad4b-company-transport/dynamic-site-binding-v1/resolver.py reconcile
ExecStart=-/usr/bin/python3 /opt/mad4b-company-transport/dynamic-site-binding-v1/wpcli_identity.py reconcile
ExecStart=-/usr/bin/python3 /opt/mad4b-company-transport/central-auto-authority-v1/auto_authority.py
ExecStart=-/usr/bin/python3 /opt/mad4b-company-transport/unified-execution-router-v1/router.py reconcile
ExecStart=-/usr/bin/python3 /opt/mad4b-company-transport/unified-execution-router-v1/lifecycle.py reconcile
ExecStart=-/usr/bin/python3 /opt/mad4b-company-transport/universal-runtime-v1/unified_lifecycle_orchestrator.py reconcile
ExecStart=-/usr/bin/python3 /opt/mad4b-company-transport/channel-governance-v1/integration.py reconcile
