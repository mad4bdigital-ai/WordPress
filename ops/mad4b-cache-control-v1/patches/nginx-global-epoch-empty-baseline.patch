+# MAD4B_PUBLIC_HTML_GLOBAL_EPOCH_V1 BEGIN
+map $host $mad4b_public_html_global_epoch {
+    default "";
+}
+# MAD4B_PUBLIC_HTML_GLOBAL_EPOCH_V1 END
 # MAD4B content-versioned Elementor post CSS: bounded cache, other URLs unchanged.
 map $arg_mad4b_ev $mad4b_elementor_css_ttl {
@@ -333,5 +338,5 @@
     auth_request /__mad4b_path_generation;
     auth_request_set $mad4b_path_etag $sent_http_etag;
