[Unit]
Description=MAD4B Form 6 immutable assets and public-route versioning (wayfa)
After=docker.service
Requires=docker.service
RequiresMountsFor=/opt/wayfa-rebuild-20261102/site-copy/wp-content
[Service]
Type=oneshot
ExecStart=/usr/bin/flock -w 45 /run/lock/mad4b-form6-permanent-assets-wayfa.lock /usr/bin/python3 /opt/mad4b-company-provisioning/bin/company-form6-asset-cache-reconciler-v1.py wayfa
NoNewPrivileges=true
UMask=0077
TimeoutStartSec=205
Nice=15
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
