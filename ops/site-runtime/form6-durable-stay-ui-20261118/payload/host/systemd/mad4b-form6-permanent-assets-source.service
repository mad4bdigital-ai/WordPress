[Unit]
Description=MAD4B Form 6 immutable assets and public-route versioning (source)
After=docker.service
Requires=docker.service
RequiresMountsFor=/opt/hostinger-migrations/hosting-3/etg-commerce-staging/site-copy/wp-content
[Service]
Type=oneshot
ExecStart=/usr/bin/flock -w 45 /run/lock/mad4b-form6-permanent-assets-source.lock /usr/bin/python3 /opt/mad4b-company-provisioning/bin/company-form6-asset-cache-reconciler-v1.py source
NoNewPrivileges=true
UMask=0077
TimeoutStartSec=205
Nice=15
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
