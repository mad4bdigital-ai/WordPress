[Unit]
Description=MAD4B Root pinned exact five external WordPress sites, SSH identity readback
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/mad4b-company-transport/host-authority-v146-external-sites-readonly/external_host_evidence.py

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/
ExecStart=/usr/bin/python3 -B /opt/mad4b-company-transport/host-authority-v146-external-sites-readonly/external_host_evidence.py --mode publish
TimeoutStartSec=235
Nice=17
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/mad4b-company-transport/host-authority-v146-external-sites-readonly
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
