# MAD4B Rate WPML Parity: event-triggered immediate sync; daily, bounded, authoritative integrity repair.
# Each run uses a named WordPress admin with pricing capabilities; it does not bypass WP meta protection.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CRON_TZ=UTC
19 3 * * * root /usr/bin/flock -n /run/lock/mad4b-rate-parity-staging.lock /usr/bin/timeout -k 5s 120s /usr/bin/nice -n 15 /usr/bin/ionice -c 3 /opt/mad4b-company-provisioning/operations/rate-price-language-parity/reconcile.sh staging >> /var/log/mad4b-rate-parity-staging.log 2>&1
41 3 * * * root /usr/bin/flock -n /run/lock/mad4b-rate-parity-wayfatours.lock /usr/bin/timeout -k 5s 120s /usr/bin/nice -n 15 /usr/bin/ionice -c 3 /opt/mad4b-company-provisioning/operations/rate-price-language-parity/reconcile.sh wayfatours >> /var/log/mad4b-rate-parity-wayfatours.log 2>&1
