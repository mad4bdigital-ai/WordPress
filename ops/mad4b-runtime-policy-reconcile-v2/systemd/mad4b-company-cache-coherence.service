[Unit]
Description=MAD4B company cache coherence reconciliation (read-only)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n /run/lock/mad4b-company-cache-coherence.lock /usr/bin/python3 /opt/mad4b-company-provisioning/bin/company-cache-coherence-reconcile.py
TimeoutStartSec=210
Nice=15
CPUQuota=60%
IOSchedulingClass=idle
NoNewPrivileges=true
UMask=0077
StandardOutput=journal
StandardError=journal
