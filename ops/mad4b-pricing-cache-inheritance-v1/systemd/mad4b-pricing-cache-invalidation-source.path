[Unit]
Description=Watch actual WordPress Pricing Policy changes for source
After=local-fs.target

[Path]
PathModified=/opt/hostinger-migrations/hosting-3/etg-commerce-staging/site-copy/wp-content/.mad4b-pricing-policy-change.signal
Unit=mad4b-pricing-cache-invalidation-source.service

[Install]
WantedBy=multi-user.target
