[Unit]
Description=MAD4B read-only Redis FLUSHDB delta and safe caller attribution
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -w 10 /run/lock/mad4b-redis-flush-origin-observe.lock /usr/bin/python3 /opt/mad4b-company-provisioning/bin/company-redis-flush-origin-observe-v1.py
TimeoutStartSec=52
Nice=15
CPUQuota=20%
NoNewPrivileges=true
UMask=0077
