[Unit]
Description=MAD4B Original305 automatic read-only incident status observation
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/mad4b-company-transport/native-313-independent/host-source-v1/original305_runtime_observer_v1.py --publish
TimeoutStartSec=150
NoNewPrivileges=true
