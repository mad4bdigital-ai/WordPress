[Unit]
Description=MAD4B audited Redis flush caller attribution, alert and archival
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -w 12 /run/lock/mad4b-redis-flush-provenance-v2.lock /usr/bin/python3 /opt/mad4b-company-provisioning/bin/company-redis-flush-provenance-v2.py --strict
TimeoutStartSec=70
Nice=15
CPUQuota=25%
IOSchedulingClass=idle
NoNewPrivileges=true
UMask=0077
StandardOutput=journal
StandardError=journal
