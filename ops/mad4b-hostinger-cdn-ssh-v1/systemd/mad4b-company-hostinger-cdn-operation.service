[Unit]
Description=MAD4B central company Hostinger CDN SSH operation and knowledge reconciliation
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStartPre=/usr/bin/python3 /opt/mad4b-company-provisioning/bin/company-hostinger-two-route-binding-v1.py
ExecStart=/usr/bin/flock -n /run/lock/mad4b-company-hostinger-cdn-operation.lock /usr/bin/python3 /opt/mad4b-company-provisioning/bin/company-hostinger-cdn-operation-v1.py --action reconcile
ExecStartPost=/usr/bin/python3 /opt/mad4b-company-provisioning/bin/company-hostinger-cdn-central-sync-v1.py
TimeoutStartSec=280
Nice=15
CPUWeight=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/mad4b-company-provisioning/reports /run/lock
UMask=0077
StandardOutput=journal
StandardError=journal
