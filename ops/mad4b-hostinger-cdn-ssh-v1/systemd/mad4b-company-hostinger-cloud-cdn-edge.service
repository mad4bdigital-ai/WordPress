[Unit]
Description=MAD4B Hostinger Cloud Startup CDN sensitive-context edge safety audit
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n /run/lock/mad4b-hostinger-cloud-edge.lock /usr/bin/python3 /opt/mad4b-company-provisioning/bin/company-hostinger-cloud-cdn-edge-audit-v1.py --strict
TimeoutStartSec=220
Nice=15
CPUWeight=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/mad4b-company-provisioning/reports /run/lock
UMask=0077
StandardOutput=journal
StandardError=journal
