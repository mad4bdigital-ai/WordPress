+		'ar' => 'ar_EG', 'fr' => 'fr_FR', 'de' => 'de_DE',
+		'es' => 'es_ES', 'it' => 'it_IT'
+	);
+	if ( isset( $locales[$lang] ) && $format === 'd M Y' && class_exists( 'IntlDateFormatter' ) ) {
+		$fmt = new IntlDateFormatter( $locales[$lang], IntlDateFormatter::NONE,
+			IntlDateFormatter::NONE, 'UTC', IntlDateFormatter::GREGORIAN, 'dd MMM yyyy' );
+		if ( $fmt ) {
+			$localized = $fmt->format( $timestamp );
+			if ( is_string( $localized ) && $localized !== '' ) return $localized;
+		}
+	}
 	return wp_date( $format, $timestamp );
 }
