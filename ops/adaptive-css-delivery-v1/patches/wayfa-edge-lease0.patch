--- a/stack/nginx.conf
+++ b/stack/nginx.conf
@@ -5,13 +5,19 @@
 # MAD4B EDGE CANARY CACHE SEPARATION v1 (origin-generated, no cookie/header opt-in).
 # split_clients uses Nginx $request_id, not a user-supplied request header.
 # Canary requests are FastCGI BYPASS+NO_CACHE, never written to shared keys.
+# Fail-closed release lease: edge cohort selection alone never exposes
+# an unqualified CSS candidate or causes needless origin-only TTFB.
+# Update this gate only through a source-bound release receipt.
+map $host $mad4b_css_candidate_release_lease_v1 {
+    default 0;
+}
 split_clients "$request_id|mad4b-css-v2-canary-20261121" $mad4b_css_split_seed {
     1% canary;
     * control;
 }
-map "$mad4b_css_split_seed|$wayfa_html_device|$wayfa_html_no_cache_request|$wayfa_html_no_cache_path" $mad4b_css_rollout_cohort {
+map "$mad4b_css_candidate_release_lease_v1|$mad4b_css_split_seed|$wayfa_html_device|$wayfa_html_no_cache_request|$wayfa_html_no_cache_path" $mad4b_css_rollout_cohort {
     default "";
-    "canary|mobile|0|0" canary;
+    "1|canary|mobile|0|0" canary;
 }
 map $mad4b_css_rollout_cohort $mad4b_css_rollout_origin_attested_v1 {
     default 0;
