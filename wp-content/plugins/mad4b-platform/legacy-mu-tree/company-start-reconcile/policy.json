{
  "contract": "mad4b.company-start-reconcile-completeness.v1",
  "source_of_truth": "live:tours.dev.mad4b.com",
  "scope": "all_company_site_environment_targets",
  "modes": {
    "fresh": "new_empty_site_with_new_company_data",
    "template_clone": "approved_generic_definitions_only",
    "tenant_migration": "same_owner_content_with_explicit_identity_continuity"
  },
  "evidence": {
    "exact_binding": [
      "company_id",
      "environment",
      "site_uuid",
      "canonical_origin",
      "profile_revision"
    ],
    "generation": "new_site_uuid_never_inherits_old_site_receipts",
    "max_age_seconds": 1800,
    "receipts_must_be_issued_by_native_provider": true,
    "require_manifest_sha256": true,
    "unknown_is_not_pass": true,
    "http_200_is_transport_only": true,
    "do_not_count_raw_source_rows_across_tenants": true
  },
  "stages": {
    "bootstrap": [
      "target_identity",
      "source_scope",
      "original_authority",
      "rollback_ready"
    ],
    "functional": [
