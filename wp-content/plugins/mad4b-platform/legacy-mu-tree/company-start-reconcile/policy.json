    ],
    "commercial": [
      "pricing_and_booking",
      "payment_checkout",
      "outbound_notifications",
      "provider_account_connections"
    ]
  },
  "provider_owners": {
    "wpml_translations": "WPML",
    "post_taxonomy_schema": "JetEngine + Native WordPress",
    "post_term_relationships": "Content Relationship Graph",
    "media_provenance": "Media",
    "jetsmartfilters_target_index": "JetSmartFilters",
    "elementor_theme_conditions": "Elementor Pro",
    "brand_kit_page_options": "Elementor Kit + JetEngine Options",
    "jetengine_queries_options": "JetEngine Query Builder",
    "fluent_form_definitions": "Fluent Forms",
    "navigation_lists": "Presentation + Site Menu",
    "desktop_visual_render": "Browser Acceptance",
    "mobile_visual_render": "Browser Acceptance",
    "all_public_languages_render": "Browser Acceptance + WPML",
    "hero_and_css_assets": "Elementor CSS + Media",
    "elementor_visual_css_source_readback": "Elementor Kit + Template Custom CSS",
    "elementor_initial_ajax_css_parity": "Elementor + JetEngine + Browser Acceptance"
  },
  "ownership_rules": {
    "shareable": [
      "provider_definitions",
      "approved_elementor_layouts",
      "generic_query_schemas",
      "generic_taxonomy_schemas",
      "unbranded_form_schemas",
      "approved_elementor_design_system_definitions"
    ],
    "tenant_owned": [
      "brand_identity",
      "company_page_option_values",
      "photos",
      "links",
      "company_text",
      "prices",
      "products",
      "contacts",
      "reviews"
    ],
    "site_generated": [
      "jet_smart_filters_index",
      "elementor_css_cache",
      "theme_condition_cache",
      "session_tokens",
      "litespeed_combined_css_cache"
    ],
    "reconnect": [
      "smtp",
      "payments",
      "analytics",
      "seo_accounts",
      "crm",
      "social",
      "licenses"
    ],
    "never_clone_across_tenants": [
      "customers",
      "orders",
      "submissions",
      "credentials",
      "oauth",
      "native_grants",
      "audit_history",
      "supplier_private_rates"
    ]
  },
  "repair_policy": {
    "discover": "provider_owned_semantic_diff",
    "auto_repair_when": "exact_target_bound AND originally_authorized_executor AND certified_provider AND reversible_plan AND readback",
    "create_content_job_on_unknown": true,
    "retry": {
      "max_attempts": 5,
      "base_delay_seconds": 90,
      "max_delay_seconds": 3600
    },
    "lock_scope": "company_id/site_uuid/environment",
    "cross_company_head_of_line_blocking": false,
    "never_forge_native_receipt": true,
    "never_replace_admin_password_during_same_tenant_migration": true,
    "no_unapproved_production_mutation": true
  },
  "readiness": {
    "bootstrap_missing": "BLOCKED_BOOTSTRAP",
    "functional_missing": "RECONCILING_FUNCTIONAL",
    "presentation_missing": "BLOCKED_PUBLICATION",
    "public_but_missing": "LIVE_WITH_GAPS_P0",
    "commerce_only_missing": "PUBLIC_READY_COMMERCE_PENDING",
    "all_pass": "COMPLETE_VERIFIED"
  },
  "css_source_policy": {
    "contract": "mad4b.elementor-css-source.v1",
    "source_authority": "source_site_live_elementor_settings_and_original_template_data",
    "editable_visual_css_sources": [
      "active_elementor_kit._elementor_page_settings.custom_css",
      "elementor_template._elementor_page_settings.custom_css",
      "elementor_global_colors_and_typography"
    ],
    "preserve_original_template_style_settings": true,
    "provider_owned_css": "preserve_native_plugin_css_for_behavior_and_hidden_states",
    "compiled_css_is_generated_not_migrated": [
      "elementor._elementor_css",
      "elementor_uploaded_post_css",
      "litespeed_css_bundles"
    ],
    "reconcile_steps": [
      "copy_authorized_kit_and_template_style_sources",
      "resolve_target_kit_identity_and_template_mapping",
      "regenerate_target_css_with_elementor_native_api",
      "validate_http_200_and_stylesheet_get_200",
      "compare_computed_styles_before_filters_after_ajax_and_after_reset",
      "verify_rtl_mobile_and_forms",
      "rollback_style_sources_on_failed_readback"
    ],
    "acceptance": "matching_target_bound_source_hashes_plus_render_parity",
    "avoid": [
      "hardcoded_target_company_css_overrides",
      "copying_compiled_css_cache_as_authority",
      "silently_activating_missing_visual_providers",
      "removing_provider_hidden_state_rules"
    ],
    "unknown_or_failed": "content_alert_and_reconcile_not_silent_success",
    "native_post_import_regeneration": {
      "provider_contract": "mad4b.elementor-css-native-reconcile.v1",
      "provider_cli": "wp mad4b-css reconcile",
      "stage_after": "template_meta_and_active_kit_mapping",
      "executor_channel": "enrolled_target_original_wpcli",
      "required_parameters": [
        "--origin=verified_target_canonical_origin",
        "--ids=target_mapped_elementor_document_ids",
        "--expected-kit-css-sha256=readback_of_target_kit_custom_css",
        "--apply"
      ],
      "write_scope": "target_wordpress_local_only",
      "original_data_sources": [
        "active_kit._elementor_page_settings",
        "templates._elementor_data",
        "templates._elementor_page_settings"
      ],
      "never_copy": [
        "template._elementor_css",
        "wp-content/uploads/elementor/css",
        "wp-content/litespeed/css"
      ],
      "target_acceptance": [
        "original_target_site_identity",
        "native_compiled_css_hash_readback",
        "initial_vs_ajax_computed_style_parity",
        "filter_reset_and_form_state"
      ],
      "skip_if_provider_not_installed": false,
      "do_not_infer_completion_from_policy": true,
      "target_auto_dispatch_verified": false
    }
  },
