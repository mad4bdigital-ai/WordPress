          "process_backend_ready",
          "normal_no_network_execution_ready"
        ],
        "unavailable_lane_policy": "fail_closed_without_disabling_ready_sibling_lanes",
        "developer_host_limitations_do_not_false_mark_governed_write_unready": true,
        "production_is_never_inferred_from_staging_lane_readiness": true,
        "developer_host_recovery": {
          "truth_source": "mad4b/full-staging-authority-handshake.developer_execution.host_recovery",
          "owner": "host_platform_operator",
          "accepted_resource_limiter": "prlimit",
