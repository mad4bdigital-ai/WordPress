{
  "contract": "mad4b.wordpress-deployment-handoff.v2",
  "producer": {
    "repository": "mad4bdigital-ai/WordPress",
    "workflow": ".github/workflows/mad4b-control-plane-package.yml",
    "artifact_name_template": "mad4b-site-control-plane-general-distribution-kit-{exact_head_sha}",
    "install_manifest": "install-manifest.json",
    "source_binding": "exact_head_sha"
  },
  "target": {
    "binding": "explicit_site_profile",
    "environment_source": "site_profile.environment",
    "origin_source": "site_profile.canonical_origin",
    "site_uuid_source": "site_profile.site_uuid",
    "supported_environments": [
      "local",
      "development",
      "staging",
      "production"
    ],
    "plugin_slug": "mad4b-site-control-plane",
    "mcp_adapter": {
      "slug": "mcp-adapter",
      "required_version": "0.7.0",
      "required_version_source": "runtime_release_policy.target_adapter_version",
      "deployment_mode": "require_exact_preinstalled_or_verified_bundled"
    }
  },
  "executor": {
    "authority": "deployment_connector_selected_by_site_owner",
    "operation": "wordpress_plugin_deploy",
    "dry_run_default": true,
    "human_approval_required_for_apply": true,
    "exact_capability_envelope_required": true,
    "exact_target_allowlist_required": true,
    "caller_supplied_credentials_allowed": false,
    "semantic_contract": "mad4b.host-runner-wordpress-plugin-deploy-plan.v1",
    "bridge_ability": "mad4b/host-operation-apply",
    "execution_location": "host_runner",
    "generic_shell_required": false,
    "caller_supplied_path_allowed": false,
    "caller_supplied_url_allowed": false
  },
  "preflight": {
    "must_precede_first_write": true,
    "required": [
      "target_site_profile_is_configured",
      "live_environment_matches_site_profile",
      "live_home_url_matches_site_profile_canonical_origin",
      "live_site_url_matches_site_profile_canonical_origin",
      "artifact_run_completed_successfully",
      "artifact_exact_head_sha_matches_request",
      "install_manifest_contract_is_valid",
      "install_manifest_commit_matches_exact_head_sha",
      "control_plane_archive_sha256_matches_manifest",
      "mcp_adapter_dependency_is_exact_or_verified"
    ]
  },
  "apply": {
    "source": "verified_control_plane_archive_from_exact_artifact",
    "backup_before_replace": true,
    "atomic_replace_required": true,
    "activate_after_replace": true,
    "same_cycle_readback_required": true,
    "rollback_on_failed_readback": true,
    "rollback_restores_previous_plugin_files": true,
    "production_requires_separate_explicit_authority": true,
    "staging_ingress": {
      "zone": "package_staging",
      "bundle_key": "exact_source_commit_sha",
      "network_fetch_by_runner": false,
      "external_deployment_connector_stages_verified_bundle": true,
      "required_bundle_members": [
        "install-manifest.json",
        "CANONICAL-PACKAGE-RECEIPT.json",
        "BUILD-FINGERPRINT.txt",
        "PACKAGE-MANIFEST-DIGEST.txt",
        "exact_control_plane_archive"
      ]
    },
    "host_runner_verification": [
      "exact_current_installed_package_identity_before_commit",
      "install_manifest_repository_and_source_match",
      "canonical_package_receipt_match",
      "archive_sha256_match",
      "embedded_build_provenance_match",
      "package_file_inventory_exact",
      "zip_traversal_and_symlink_denied",
      "same_cycle_installed_package_identity_readback"
    ],
    "first_bootstrap_note": "A runtime predating both wordpress_plugin_deploy and the bootstrap self-update step-up still requires one already-authorized external deployment connector for the first Host Bridge/Runner-capable candidate. Runtimes containing mad4b/control-plane-bootstrap-apply can repair later candidate-drift self-update deadlocks through the exact Staging step-up path without widening Write, Developer, Breakglass, or Production authority.",
    "activation_mode": "preserve_existing_active_plugin_state_during_exact_directory_replace_then_verify_on_fresh_request",
    "active_runtime_required_before_host_runner_replace": true
  },
  "post_deploy": {
    "required_live_acceptance": [
      "exact_control_plane_version_and_build_readback",
      "site_profile_identity_exact",
      "enabled_feature_reconciliation",
      "functional_gap_zero_touch_repository_evidence_exact_head",
      "functional_gap_zero_touch_runtime_fixed_point_stable",
      "functional_gap_zero_touch_promotion_remains_non_authorizing",
      "provider_blocked_write_tools_safely_unmounted",
      "external_tool_inventory_match_when_mcp_enabled",
      "one_time_approval_replay_denial_and_undo_when_write_enabled",
      "context_human_review_admin_ui_visible_for_governed_assets",
      "context_task_local_human_review_controls_absent",
      "context_review_queue_read_only_surface_available",
      "context_review_audit_read_only_surface_available",
      "context_brand_core_coverage_read_only_surface_available",
      "context_human_review_mcp_mutation_surface_absent",
      "plugin_package_plan_read_only_surface_available",
      "plugin_package_apply_requires_exact_governed_write_authority",
      "plugin_package_caller_supplied_url_and_path_absent",
      "plugin_package_apply_preserves_activation_state_and_rolls_back_on_failed_disk_readback",
      "context_review_default_mode_human_only_after_upgrade",
      "context_ai_review_admin_confirmation_required",
      "context_ai_review_stable_catalog_present_but_runtime_blocked_until_delegation",
      "context_ai_review_exact_agent_and_exact_grant_required",
      "context_ai_review_policy_change_does_not_auto_reconcile_grants",
      "context_ai_review_runtime_mount_changes_write_inventory_only_after_policy_enablement",
      "context_ai_review_exact_candidate_binding_and_write_authority_required",
      "context_ai_review_exact_bound_stale_evidence_rejected",
      "context_ai_review_governance_metadata_and_quality_immutable",
      "context_ai_review_audit_actor_attribution_exact",
      "context_human_review_remains_available_after_ai_enablement",
      "context_ai_review_production_remains_unauthorized",
      "chatgpt_refresh_initialize_and_tools_list_within_certified_budget",
      "chatgpt_compact_transport_catalog_preserves_full_governed_discovery",
      "oauth_resource_specific_scopes_match_chatgpt_enrollment_developer_surfaces",
      "developer_runtime_isolated_from_chatgpt_and_normal_write_surfaces",
      "developer_runtime_non_production_only",
      "developer_breakglass_separately_gated_and_disabled_by_default",
      "full_staging_authority_plan_read_only_before_apply",
      "full_staging_authority_apply_requires_exact_clean_plan_and_explicit_operator_authority",
      "generic_raw_sql_breakglass_remains_excluded"
    ]
  },
  "forbidden": {
    "unenrolled_target": true,
    "implicit_production_write": true,
    "breakglass": true,
    "raw_sql_side_channel": true,
    "caller_supplied_credentials": true,
    "merge_or_ready_before_required_acceptance": true
  },
  "secrets_included": false,
  "self_update": {
    "contract": "mad4b.control-plane-self-update.v1",
    "purpose": "permanent_multi_channel_control_plane_updates_after_first_bootstrap",
    "channels": {
      "wordpress_native_update": {
        "surface": "wp-admin/plugins_and_updates",
        "distribution": "repository_owned_github_release_channel",
        "manifest_asset": "mad4b-site-control-plane-update.json",
        "package_asset_template": "mad4b-site-control-plane-{exact_source_commit_sha}.zip",
        "publish_gate": "successful_exact_master_release_verdict",
        "automatic_update": false,
        "exact_archive_sha256_required": true,
        "embedded_build_provenance_required": true,
        "backup_before_replace": true,
        "readback_required": true,
        "rollback_on_failed_readback": true,
        "production_requires_explicit_opt_in": true,
        "pointer_asset": "mad4b-site-control-plane-update-pointer.json",
        "immutable_manifest_asset_template": "mad4b-site-control-plane-update-{exact_source_commit_sha}.json",
        "legacy_manifest_asset": "mad4b-site-control-plane-update.json",
        "resolution": "pointer_first_with_network_or_http_unavailable_legacy_fallback",
        "pointer_manifest_sha256_required": true,
        "pointer_release_verdict_binding_required": true
      },
      "governed_file_upload": {
        "ability_plan": "mad4b/control-plane-upload-plan",
        "ability_apply": "mad4b/control-plane-upload-apply",
        "input_transport": "bounded_base64_zip",
        "caller_supplied_url_allowed": false,
        "caller_supplied_path_allowed": false,
        "staging_only": true,
        "exact_plan_required": true,
        "exact_one_time_approval_required": true,
        "exact_archive_sha256_required": true,
        "embedded_build_provenance_required": true,
        "backup_before_replace": true,
        "readback_required": true,
        "rollback_on_failed_readback": true,
        "production_allowed": false
      },
      "governed_native_release_pull": {
        "ability_plan": "mad4b/control-plane-native-plan",
        "ability_apply": "mad4b/control-plane-native-apply",
        "distribution": "repository_owned_github_release_channel",
        "manifest_asset": "mad4b-site-control-plane-update.json",
        "caller_supplied_url_allowed": false,
        "caller_supplied_path_allowed": false,
        "caller_package_bytes_allowed": false,
        "target_derived_from_release_manifest": true,
        "staging_only": true,
        "exact_plan_required": true,
        "exact_one_time_approval_required": true,
        "exact_archive_sha256_required": true,
        "embedded_build_provenance_required": true,
        "release_verdict_required": true,
        "backup_before_replace": true,
        "readback_required": true,
        "rollback_on_failed_readback": true,
        "production_allowed": false,
        "pointer_asset": "mad4b-site-control-plane-update-pointer.json",
        "immutable_manifest_asset_template": "mad4b-site-control-plane-update-{exact_source_commit_sha}.json",
        "legacy_manifest_asset": "mad4b-site-control-plane-update.json",
        "resolution": "pointer_first_with_network_or_http_unavailable_legacy_fallback",
        "pointer_manifest_sha256_required": true,
        "pointer_release_verdict_binding_required": true
      },
      "governed_bootstrap_release_pull": {
        "ability_apply": "mad4b/control-plane-bootstrap-apply",
        "oauth_scope": "mad4b:authority:step-up",
        "client_binding": "exact_chatgpt_cimd_client",
        "execution_core": "governed_native_release_pull",
        "purpose": "break_candidate_binding_self_update_circular_dependency",
        "availability": "staging_only_when_normal_write_authority_is_not_effective_and_current_exact_grants_are_clean",
        "exact_plan_required": true,
        "explicit_confirmation_required": true,
        "release_channel_bound": true,
        "target_derived_from_release_manifest": true,
        "caller_supplied_url_allowed": false,
        "caller_supplied_path_allowed": false,
        "caller_package_bytes_allowed": false,
        "grant_mutation_allowed": false,
        "developer_authority_mutation_allowed": false,
        "developer_breakglass_mutation_allowed": false,
        "generic_raw_sql_breakglass_included": false,
        "production_allowed": false,
        "backup_before_replace": true,
        "readback_required": true,
        "rollback_on_failed_readback": true,
        "self_disables_after_normal_write_authority_becomes_effective": true
      }
    },
    "shared_verification": [
      "pointer_source_commit_sha",
      "pointer_manifest_sha256",
      "pointer_release_verdict_run_id",
      "archive_sha256",
      "safe_zip_inventory",
      "embedded_source_commit_sha",
      "embedded_build_fingerprint",
      "embedded_package_manifest_digest",
      "installed_exact_identity_readback"
    ],
    "first_bootstrap": {
      "required_for_runtime_predating_this_contract": true,
      "external_deployment_connector_required_once": true,
      "self_update_channels_available_after_first_bootstrap": true,
      "bootstrap_step_up_after_initial_install": true,
      "stale_candidate_recovery": "Use mad4b/control-plane-bootstrap-apply when the installed runtime already contains this contract, normal Write Authority is fail-closed only on candidate drift, and current exact grants are otherwise clean."
    },
    "forbidden": {
      "arbitrary_remote_url": true,
      "arbitrary_filesystem_path": true,
      "automatic_background_self_update": true,
      "production_remote_file_upload": true,
      "bypass_exact_approval": true,
      "production_remote_native_pull": true
    }
  }
}
