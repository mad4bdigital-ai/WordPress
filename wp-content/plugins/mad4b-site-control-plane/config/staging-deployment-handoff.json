        "universal_db_query_threshold": false,
        "universal_included_file_threshold": false,
        "universal_memory_threshold": false,
        "material_regression_requires_review": true,
        "missing_baseline_state": "baseline_required_not_failure",
        "regression_state": "review_required",
        "no_regression_state": "accepted_comparative_observation",
        "automatic_tuning_allowed": false,
        "automatic_index_ddl_allowed": false,
        "automatic_cache_authority_allowed": false,
        "authorizing": false,
        "production_mutation_allowed": false,
        "explicit_diagnostic_budget_is_hard_boundary": true,
        "total_request_elapsed_is_comparative_signal": true,
        "diagnostic_elapsed_is_budgeted_signal": true
      }
    }
