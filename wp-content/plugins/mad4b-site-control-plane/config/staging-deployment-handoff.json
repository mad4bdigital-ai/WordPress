        "source": "mad4b/session-safe-diagnostics.performance_observation",
        "exact_runtime_generation_required": true,
        "exact_site_profile_required": true,
        "comparison_required": true,
        "baseline_scope": "previous_exact_staging_release",
        "workload_profile": "same_site_same_session_safe_bundle_order",
