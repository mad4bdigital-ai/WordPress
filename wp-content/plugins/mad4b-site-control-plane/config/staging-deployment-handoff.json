            "ability": "mad4b/full-staging-authority-handshake",
            "read_only": true,
            "automatic_apply_allowed": false
          },
          "skills_runtime_not_effective": {
            "action": "inspect_then_explicitly_reconcile_managed_skills",
            "ability": "mad4b/reconcile-managed-skills",
            "explicit_authority_required": true,
            "automatic_apply_allowed": false
          },
          "partial_report": {
            "action": "inspect_partial_report_then_retry_missing_scope",
            "mutation_target": "",
            "automatic_apply_allowed": false
          },
          "ready_subject": {
            "action": "continue_with_single_target_operation"
          }
        }
      },
      "acceptance": {
        "operational_ready_requires_all_requested_lanes_ready": true,
        "degraded_mode_is_explicit": true,
        "available_lanes_must_be_reported": true,
        "blocked_lanes_must_be_reported": true,
        "blockers_must_have_recovery_action": true,
        "automatic_authority_mutation_allowed": false,
        "production_mutation_allowed": false,
        "generic_raw_sql_breakglass_included": false,
