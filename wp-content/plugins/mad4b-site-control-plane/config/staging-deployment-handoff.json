          "network_sandbox_config_constant": "MAD4B_MCP_DEVELOPER_NETWORK_SANDBOX_BIN",
          "proc_open_required": true,
          "non_root_worker_required": true,
          "php_binary_required_for_lint": true,
          "wordpress_self_repair_allowed": false,
          "automatic_install_allowed": false,
          "weaker_unsandboxed_fallback_allowed": false,
          "developer_lane_remains_blocked_until_reverified": true,
          "governed_write_sibling_lane_may_remain_available": true,
          "production_mutation_allowed": false
