      "read_only_truth_sources": {
        "runtime_and_session": "mad4b/session-safe-diagnostics",
        "catalog_and_protocol": "mad4b/chatgpt-tool-projection-status",
        "current_write_authority": "mad4b/staging-write-authority-convergence-handshake",
