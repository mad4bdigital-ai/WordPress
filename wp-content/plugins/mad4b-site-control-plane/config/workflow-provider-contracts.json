{
  "contract": "mad4b.workflow-provider-contracts.v1",
  "default_provider": "bitflows",
  "provider_selection": "explicit_or_default",
  "source_of_truth": "mad4b_workflow_plan",
  "providers": {
    "bitflows": {
      "adapter_id": "bitflows",
      "provider_key": "bit_pi",
      "role": "execution_provider",
      "operations": {
        "list": {
          "ability": "bitflows/list-flows",
          "risk": "read",
          "capability_id": "flows.read"
        },
        "get": {
          "ability": "bitflows/get-flow",
          "risk": "read",
          "capability_id": "flows.read"
        },
        "execution_status": {
          "ability": "bitflows/get-executions",
          "risk": "read",
          "capability_id": "flows.read"
        },
        "execute": {
          "ability": "bitflows/run-flow",
          "risk": "high_risk_write",
          "requires": [
            "provider_capability_certified",
            "exact_workflow_fingerprint",
            "exact_nhi_grant",
            "one_time_approval",
            "budget",
            "audit"
          ],
          "capability_id": "flow.execute"
        },
        "create": {
          "ability": null,
          "risk": "high_risk_write",
          "state": "unavailable",
          "blocker": "public_provider_contract_not_certified",
          "capability_id": null
        },
        "enable": {
          "ability": null,
          "risk": "bounded_write",
          "state": "unavailable",
          "blocker": "public_provider_contract_not_certified",
          "capability_id": null
        },
        "disable": {
          "ability": null,
          "risk": "bounded_write",
          "state": "unavailable",
          "blocker": "public_provider_contract_not_certified",
          "capability_id": null
        },
        "retry": {
          "ability": null,
          "risk": "high_risk_write",
          "state": "unavailable",
          "blocker": "public_provider_contract_not_certified",
          "capability_id": null
        },
        "cancel": {
          "ability": null,
          "risk": "high_risk_write",
          "state": "unavailable",
          "blocker": "public_provider_contract_not_certified",
          "capability_id": null
        }
      },
      "implementation_policy": {
        "internal_database_writes": "forbidden",
        "caller_supplied_credentials": "forbidden",
        "direct_production_authority": "forbidden",
        "governance_owner": "mad4b",
        "workflow_mechanics_owner": "provider"
      }
    }
  }
}
