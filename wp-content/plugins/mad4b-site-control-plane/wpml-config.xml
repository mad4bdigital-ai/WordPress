<?xml version="1.0" encoding="UTF-8"?>
<wpml-config>
  <!-- Tour Highlights: language-specific editorial copy. -->
  <custom-fields>
    <custom-field action="translate" translate_link_target="1">tour_highlights_content</custom-field>
    <custom-field action="translate">tour_highlights_intro</custom-field>
    <!-- Preserve independent per-language curation, never sync EN over ES/AR/FR/DE/IT. -->
    <custom-field action="copy-once">tour_highlights_items</custom-field>
    <custom-field action="copy-once">tour_highlights_mode</custom-field>
    <custom-field action="copy-once">tour_highlights_display_pattern</custom-field>
  </custom-fields>
</wpml-config>
