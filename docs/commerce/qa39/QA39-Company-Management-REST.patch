+            $given=array_keys($body);sort($expected);sort($given);
+            if($expected!==$given||!is_string($body['to_state'])||
+                !is_string($body['reason_code']))
+                return self::failure('management_command_schema_invalid',400);
+            $result=RequestReview::decide($id,$body['to_state'],
+                $body['expected_review_revision'],$body['reason_code'],$key);
+        }else{
