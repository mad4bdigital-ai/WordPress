+        // mandatory even for existing bounded review/task operations.
+        if(!$ctx['write_ready'])return self::failure('management_site_authority_not_ready',409);
+        $body=$r->get_json_params();
+        if(!is_array($body)||array_is_list($body))
+            return self::failure('management_command_payload_invalid',400);
+        $key=(string)$r->get_header('idempotency-key');
+        if(!preg_match('/^[A-Za-z0-9._:-]{16,128}$/D',$key))
+            return self::failure('management_idempotency_key_required',400);
+        $uuid=$body['site_uuid']??null;
