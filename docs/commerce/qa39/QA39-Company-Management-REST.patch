+    public static function actions(\WP_REST_Request $r):\WP_REST_Response|\WP_Error {
+        $ctx=self::context();
+        if(is_wp_error($ctx))return self::error($ctx);
+        if($ctx['definition']['domains']['reviews']!==true)
+            return self::failure('management_resource_disabled',403);
+        $id=(int)$r['request_id'];
+        $read=RequestReview::read($id);
+        if(is_wp_error($read))return self::error($read);
+        $reviewer=current_user_can('commerce_review_requests')||
+            current_user_can('manage_options');
+        $manager=current_user_can('commerce_approve_request_processing')||
