+            !is_int($revision)||$revision!==$ctx['site_profile_revision'])
+            return self::failure('management_company_context_mismatch',409);
+        if(!is_int($body['expected_review_revision']??null)||
+            $body['expected_review_revision']<0)
+            return self::failure('management_revision_required',400);
+        $action=$body['action']??null;
