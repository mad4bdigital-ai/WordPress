+                'woo_order_create'=>false,'payment_capture'=>false,
+                'supplier_booking_create'=>false,'accounting_post'=>false],
+            'write_ready'=>$ctx['write_ready'],
+            'write_blockers'=>$ctx['write_blockers']]);
+    }
+    public static function command(\WP_REST_Request $r):\WP_REST_Response|\WP_Error {
+        $ctx=self::context();
