+            $transitions[]=['to_state'=>$state,'eligible'=>$permitted,
+                'executable'=>$permitted&&$ctx['write_ready'],
+                'requires_idempotency_key'=>true,'source_owner'=>'request_review'];
+        }
+        $task=$ctx['definition']['domains']['tasks']===true&&$taskUser;
+        return self::respond(['site_uuid'=>$ctx['site_uuid'],
+            'request_id'=>$id,'review_revision'=>$read['revision'],
+            'review_state'=>$read['review_state'],'transitions'=>$transitions,
+            'reason_codes'=>RequestReview::reasonCodes(),
