+            $result=FluentBoardsTaskBridge::ensure($id);
+        }
+        if(is_wp_error($result))return self::error($result);
+        return self::respond(['source_owner'=>$action==='review.transition'?
+            'request_review':'fluentboards_task_bridge','result'=>$result,
+            'financial_authority_granted'=>false]);
+    }
+    private static function error(\WP_Error $error):\WP_Error {
